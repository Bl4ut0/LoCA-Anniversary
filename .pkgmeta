package-as: LoCA
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

move-folders:
  LoCA/LoCA: LoCA

ignore:
  - .github
  - .tools
  - .versions
  - BlizzardInterfaceCode
  - CURSEFORGE_DESCRIPTION.md
  - Images
  - node_modules
  - package.json
  - package-lock.json
  - README.md
  - release_notes.md
  - TECHNICAL_CHANGES.md
